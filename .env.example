GROQ_API_KEY=
GEMINI_API_KEY=
CHEDMED_API_BASE_URL=
CHEDMED_API_KEY=
AI_WEBHOOK_SECRET=

# Conservative shared-host CPU defaults. Explicit process values take precedence.
AI_TORCH_NUM_THREADS=2
AI_TORCH_INTEROP_THREADS=1
AI_EMBEDDING_BATCH_SIZE=16
AI_INDEX_BUILD_BATCH_SIZE=500
AI_BUILD_LOCAL_INDEX_ON_STARTUP=false

# Enable this in exactly one process. Leave disabled in other API workers.
ENABLE_BACKUP_SCHEDULER=false
BACKUP_SYNC_INTERVAL_MINUTES=15
